{
  "name": "drift",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "ios": "expo start --ios --dev-client",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "config:check": "expo config --type public",
    "build:pages": "expo export --platform web && node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@rnmapbox/maps": "^10.3.5",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "mapbox-gl": "^2.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
